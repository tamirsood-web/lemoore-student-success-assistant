# Example environment configuration — PLACEHOLDER names only, never real secrets.
# Copy to `.env.local` (gitignored) and fill in real values for local development.
# Every value here is SERVER-ONLY and must never be exposed to the browser.

# --- RAG provider selection ---
# local   = deterministic offline official-source corpus (default; used by tests)
# bedrock = live Amazon Bedrock Knowledge Base via RetrieveAndGenerate
RAG_PROVIDER=local

# --- Amazon Bedrock Knowledge Base (required only when RAG_PROVIDER=bedrock) ---
# vector  = standard/customer-managed VECTOR KB (uses RetrieveAndGenerate)
# managed = managed KB (RetrieveAndGenerate NOT used; app returns service-unavailable)
BEDROCK_KB_TYPE=vector
AWS_REGION=us-west-2
BEDROCK_KNOWLEDGE_BASE_ID=replace-with-kb-id
BEDROCK_MODEL_ARN=replace-with-model-or-inference-profile-arn
BEDROCK_NUMBER_OF_RESULTS=8
BEDROCK_REQUEST_TIMEOUT_MS=15000

# AWS credentials come from the AWS default provider chain (env vars, shared config,
# or an IAM execution role). Do NOT put AWS access keys in this or any tracked file.

# --- App ---
CHAT_MAX_INPUT_CHARS=2000
